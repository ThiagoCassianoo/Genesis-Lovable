# ⚠️ ESTE ARQUIVO VAI PRO GITHUB — NUNCA COLE CHAVE REAL AQUI. ⚠️
# Chave de verdade vai em `runtime/.env` (esse sim tá no .gitignore e
# fica só na sua máquina). Aconteceu 2x nesta sessão (2026-08-26) de
# chave real ser colada aqui por engano — se você está copiando uma
# chave agora, pare e confirme que o arquivo aberto é `.env`, não
# `.env.example` (o nome é parecido de propósito, cuidado no autopreencher
# do editor).
#
# Copie este arquivo pra .env (nunca commite o .env de verdade — já
# está no .gitignore da raiz do repo).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Fallback grátis — ordem default REAL está em ORDEM_DEFAULT, src/router.js
# (não duplicar a lista aqui — já ficou desatualizada 1x nesta sessão
# quando GLM/OpenRouter/Pollinations entraram e este comentário não foi
# atualizado junto; achado pelo fiscal-agent, 2026-08-26). Motivo e
# limites reais de cada provider em docs/custos.md e docs/recursos.md.
# Nenhum provider grátis exige cartão de crédito pra pegar a chave.
GROQ_API_KEY=
CEREBRAS_API_KEY=

# GLM (Z.AI) — grátis, 2º na ordem default (ver src/router.js).
# Chave grátis em https://z.ai
GLM_API_KEY=

# OpenRouter — registrado em 2026-08-26. Grátis mas com limite (20 RPM
# / 50 RPD sem crédito, 1000 RPD depois de US$10 de crédito comprado 1x
# — ver docs/recursos.md). Por isso fica perto do fim da ordem default,
# não no topo. Modelo padrão dos dois tiers: nvidia/nemotron-3-super-120b-a12b:free
# — os defaults originais (z-ai/glm-5.2:free, google/gemma-4-31b-it:free)
# devolveram 429 "Provider returned error" (modelo congestionado do lado
# de quem hospeda) em teste real; troca registrada em docs/decisoes.md,
# 2026-08-26. Ver src/providers/openrouter-provider.js se quiser trocar
# de novo (ex.: stealth/ox-alpha, bom mas com preview de ~1 semana a
# partir de 20/08 — pode sumir a qualquer momento).
# Chave grátis em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pollinations — registrado em 2026-08-26. NÃO precisa de chave (é o
# único provider keyless do fallback) — nada a preencher aqui, funciona
# fora da caixa. POLLINATIONS_API_KEY é opcional, só se você se
# cadastrar em auth.pollinations.ai por algum motivo específico depois.
# Limite do tier anônimo: 1 requisição a cada 15s — é rede de segurança
# de último recurso grátis, não rota de volume. Ver src/router.js.
# POLLINATIONS_API_KEY=

# DeepSeek — registrado em 2026-08-26. ATENÇÃO: é o ÚNICO provider PAGO
# de todo o fallback — e está FORA da ORDEM_DEFAULT em src/router.js
# desde 2026-08-26 (não "por último", está DE FORA mesmo): a chave
# testada nesta sessão devolveu "402 Insufficient Balance" (sem saldo).
# Continua registrado em PROVIDERS pra uso explícito
# (`--order=deepseek` ou passando `order` na mão) — só não entra
# sozinho numa chamada normal. Reativar na ordem default: recarregar
# saldo em https://platform.deepseek.com e colocar "deepseek" de volta
# no array `order` default de `sendMessage()` em src/router.js.
DEEPSEEK_API_KEY=

# Opcional — só preencha se quiser fixar um modelo diferente do
# default do código para aquele TIER (não por agente — o tier de cada
# agente já vem do frontmatter dele, ver docs/model-assignment.md).
# Verificados contra a doc oficial de cada provider em 2026-08-16 —
# CONFIRME de novo antes de confiar, nome de modelo muda com frequência:
#   https://platform.claude.com/docs/en/about-claude/models/overview
#   https://ai.google.dev/gemini-api/docs/models
# CLAUDE_MODEL_OPUS=claude-opus-5
# CLAUDE_MODEL_SONNET=claude-sonnet-5
# GEMINI_MODEL_CAPAZ=gemini-2.5-pro
# GEMINI_MODEL_ECONOMICO=gemini-3.5-flash-lite
# GROQ_MODEL_CAPAZ=openai/gpt-oss-120b
# GROQ_MODEL_ECONOMICO=openai/gpt-oss-20b
#   (llama-3.3-70b-versatile e llama-3.1-8b-instant foram DESLIGADOS
#    pela Groq em 2026-08-16 — não use, dão erro. Ver docs/custos.md.)
# CEREBRAS_MODEL_CAPAZ=gpt-oss-120b
# CEREBRAS_MODEL_ECONOMICO=gpt-oss-120b
#   (llama-3.3-70b e llama3.1-8b foram DESCONTINUADOS pela Cerebras em
#    2026-02-16 e 2026-05-27 — não use, dão 404. Ver docs/custos.md.)

# Opcional — resiliência do router (timeout, retry, circuit breaker).
# Todos têm default sensato no código; só mexa se precisar ajustar pra
# um caso real (ex.: provider lento demais, ou circuito abrindo cedo
# demais num teste). Ver src/router.js pro comportamento exato.
# RUNTIME_PROVIDER_TIMEOUT_MS=60000
# RUNTIME_RETRY_ATTEMPTS=2
# RUNTIME_RETRY_BASE_DELAY_MS=300
# RUNTIME_RETRY_MAX_DELAY_MS=2000
# RUNTIME_BREAKER_THRESHOLD=3
# RUNTIME_BREAKER_WINDOW_MS=60000
# RUNTIME_BREAKER_COOLDOWN_MS=30000

# Opcional — janela de histórico do cli.js (achado 2026-08-16: sem
# limite, o histórico inteiro era reenviado a cada turno e zerava o
# token antes do 3º agente numa conversa real). 6 turnos = 12
# mensagens (user+assistant). Ver src/cli.js pro comportamento exato.
# RUNTIME_MAX_HISTORY_TURNS=6
